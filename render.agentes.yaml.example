# Ejemplo revisable. No activa servicios ni modifica producción automáticamente.
services:
  - type: cron
    name: clinica-agentes-tareas
    runtime: python
    schedule: "*/5 * * * *" # UTC. Ejecuta vencimientos con demora habitual de hasta cinco minutos.
    buildCommand: pip install -r requirements.txt
    startCommand: python -m llm.cli ejecutar
    envVars:
      - key: RENDER_CRON_JOB
        value: "true"
      - key: SECRET_KEY
        sync: false
      - key: APP_USERNAME
        sync: false
      - key: APP_PASSWORD
        sync: false
      - key: APP_PUBLIC_URL
        sync: false
      - key: RESEND_API_KEY
        sync: false
      - key: MAIL_FROM
        sync: false
      - key: SUPABASE_URL
        sync: false
      - key: SUPABASE_SERVICE_ROLE_KEY
        sync: false
      - key: REPORTES_BUCKET
        value: clinica-reportes
      - key: PYTHON_VERSION
        value: 3.12.14
      - key: DATABASE_URL
        sync: false
      - key: GEMINI_API_KEY
        sync: false
      - key: GROQ_API_KEY
        sync: false
      - key: GEMINI_MODEL
        value: gemini-3.5-flash-lite
      - key: GROQ_MODEL
        value: openai/gpt-oss-20b
      - key: AGENTES_TIMEOUT
        value: "15"
      - key: ML_MODEL_DIR
        value: ./ml/modelos_entrenados
